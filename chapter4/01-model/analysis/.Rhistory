knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(glmmTMB)
library(ggridges)
library(ggtext)
library(patchwork)
# SET PLOT THEMES AND COLOURS
# extrafont::loadfonts()
theme_set(theme_bw(base_size = 10))
theme_update(axis.line.x = element_line(color = "black"),
axis.line.y = element_line(color = 'black'),
text = element_text(family = "Charter"),
axis.text = element_text(size = 8),
plot.margin = margin(c(0,0,0,0)),
panel.background = element_rect(fill = 'transparent'),
plot.background = element_rect(fill = 'transparent', color = 'NA'))
colours = c(
'generation' = '#EF476F',
'gender' = '#F9844A',
'lineal' = '#FFD166',
'gcr' = '#43AA8B',
'seniority' = '#277DA1',
'speaker_gender' = '#7B2CBF')
line_colours = c(
'generation' = '#C70039',
'gender' = '#ce5a31',
'lineal' = '#cea931',
'gcr' = '#26956e',
'seniority' = '#266b95',
'speaker_gender' = '#632695')
df <- read_csv('data/model_run.csv')
colnames(df)
df_long <- df %>% pivot_longer(cols = c(generation, gender, lineal, gcr, seniority, speaker_gender),names_to = 'feature',values_to = 'weight')
df_long
paper_sample_languages <- c('English','German','Hawaiian','Hindi','Indonesian','Myene','Māori', 'Nepali', 'Seki', 'Selkup', 'Yansi','Nimboran')
paper_sample <- df_long %>% filter(language %in% paper_sample_languages) %>%
mutate(
label = sprintf('%s \n (%s)',language,family), # create a facet label: language (family)
label = factor(label)) %>%
unique() # remove duplicates if there are any
paper_sample
random_sample_languages <- c(sample(df$language,12))
random_sample <- df_long %>% filter(language %in% random_sample_languages) %>%
mutate(
label = sprintf('%s \n (%s)',language,family), # create a facet label: language (family)
label = factor(label)) %>%
unique() # remove duplicates if there are any
random_sample
axis_labels = c(
'gender' = 'gend.',
'generation' = 'gene.',
'seniority' = 'sen.',
'speaker_gender' = 'speak.',
'lineal' = 'line.',
'gcr' = 'conn.'
)
random_sample %>%
ggplot(aes(y = weight, x = feature, fill = feature)) +
scale_fill_manual(name = '', labels = features, values = colours) +
scale_x_discrete(labels = axis_labels) +
geom_col() +
labs(x = '\nSemantic feature',y = 'Weight value') +
facet_wrap(~label,nrow = 2) +
lims(y = c(0,1)) +
theme(legend.key.size = unit(0.3, 'cm'),
legend.position = 'top',
legend.margin=margin(c(1,5,-5,5)),
legend.background = element_rect(fill = 'NA'),
legend.text = element_text(size = 7),
axis.text.x = element_blank(),
strip.text = element_text(size = 7)) +
guides(fill = guide_legend(nrow = 1))
axis_labels = c(
'gender' = 'gend.',
'generation' = 'gene.',
'seniority' = 'sen.',
'speaker_gender' = 'speak.',
'lineal' = 'line.',
'gcr' = 'conn.'
)
features <-
c(
'generation' = 'Generation',
'gender' = 'Gender',
'speaker_gender' = 'Speaker\n gender',
'lineal' = 'Lineality',
'gcr' = 'GCR',
'seniority' = 'Seniority'
)
random_sample %>%
ggplot(aes(y = weight, x = feature, fill = feature)) +
scale_fill_manual(name = '', labels = features, values = colours) +
scale_x_discrete(labels = axis_labels) +
geom_col() +
labs(x = '\nSemantic feature',y = 'Weight value') +
facet_wrap(~label,nrow = 2) +
lims(y = c(0,1)) +
theme(legend.key.size = unit(0.3, 'cm'),
legend.position = 'top',
legend.margin=margin(c(1,5,-5,5)),
legend.background = element_rect(fill = 'NA'),
legend.text = element_text(size = 7),
axis.text.x = element_blank(),
strip.text = element_text(size = 7)) +
guides(fill = guide_legend(nrow = 1))
