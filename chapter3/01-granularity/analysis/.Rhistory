annotations <- data.frame(
family = c('Atlantic-Congo','Atlantic-Congo', 'Atlantic-Congo','Austronesian','Austronesian','Austronesian', 'Indo-European', 'Indo-European','Indo-European'),
language = c('Tiv', 'Zulu', 'Batanga', 'Paiwan', 'Indonesian', 'Gane', 'Italian', 'Danish', 'Hindi'),
lab_x = c(0.05, 0.25, 0.8, 0.1, 0.6, 0.7, 0.18, 0.25, 0.68),
lab_y = c(7, 28, 9, 20, 31, 7, 14, 23, 16),
line_x = c(0.1, 0.28, 0.83, 0.08, 0.5, 0.6, 0.2, 0.25, 0.67),
line_xend = c(0.2,0.33,0.83,0.08,0.25,0.43,0.27,0.37,0.67),
line_y = c(5, 24, 6, 17, 28, 6, 10, 20, 13),
line_yend = c(2, 18, 2, 4, 23, 2, 3, 12, 9)
)
gran %>% filter(family %in% c('Atlantic-Congo', 'Austronesian','Indo-European')) %>% group_by(family) %>%
mutate(
mean = mean(prop),
sd = sd(prop),
n = n()
) %>%
ggplot() +
geom_histogram(aes(x = prop, fill = family), bins = 25, colour = 'black',linewidth = 0.1, alpha = 0.8) +
geom_text(
data    = annotations,
mapping = aes(x = lab_x, y = lab_y, label = language), family = 'Charter', size = 3) +
geom_segment(
data = annotations, mapping = aes(x = line_x, y = line_y, xend = line_xend, yend = line_yend), linewidth = 0.01
) +
scale_fill_manual(name = 'Family', values = fam_colours) +
geom_vline(aes(xintercept = mean), linetype = 'dashed',linewidth = 0.2) +
geom_label(data = labels, aes(x = 0.75, y = 38, label = paste0('n = ', n), family = 'Charter'), size = 3) +
lims(x = c(0,1)) +
labs(x = 'Kin term granularity',
y = 'count') +
facet_wrap(~family) +
theme(legend.position = 'none',
plot.margin = margin(c(0,0,0,0)),
axis.text.x = element_text(size = 8),
panel.spacing = unit(1, "lines"))
ggsave('plots/lex_size_fam.pdf', device = cairo_pdf, unit = 'cm', width = 15, height = 6)
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(ape)
library(nlme)
library(caper)
library(geiger)
library(phytools)
library(brms)
library(lmerTest)
library(bayesplot)
# PLOT THEMES AND COLOURS
fam_colours = c(
'Atlantic-Congo' = '#7A9B76',
'Austronesian' = '#D93843',
'Indo-European' = '#F09C1D'
)
gran_pop <- read_csv('data/preprocessed/granularity_population.csv')
gran_pop <- gran_pop %>% mutate(log_pop_c = scale(log_pop))
gran_pop %>% filter(language_family %in% c('Atlantic-Congo','Austronesian','Indo-European')) %>%
ggplot(aes(x = prop, y = log_pop)) +
scale_fill_manual(values = fam_colours) +
geom_jitter(aes(fill = language_family),colour = 'black', stroke = 0.05, size = 2.5, shape = 21, alpha = 0.8, width = 0.2, height = 0.2) +
geom_abline(intercept = 0, slope = 0.1) +
lims(x = c(0,1)) +
labs(x = 'Kin term granularity', y = 'Log population size') +
scale_x_continuous(labels = c(0,0.25,0.5,0.75,1)) +
# facet_wrap(~language_family) +
theme(legend.position = 'none',
plot.margin = margin(c(0,0,0,0)))
gran_pop %>% filter(family %in% c('Atlantic-Congo','Austronesian','Indo-European')) %>%
ggplot(aes(x = prop, y = log_pop)) +
scale_fill_manual(values = fam_colours) +
geom_jitter(aes(fill = language_family),colour = 'black', stroke = 0.05, size = 2.5, shape = 21, alpha = 0.8, width = 0.2, height = 0.2) +
geom_abline(intercept = 0, slope = 0.1) +
lims(x = c(0,1)) +
labs(x = 'Kin term granularity', y = 'Log population size') +
scale_x_continuous(labels = c(0,0.25,0.5,0.75,1)) +
